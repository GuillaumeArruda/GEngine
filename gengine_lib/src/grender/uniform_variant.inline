template<>
void apply_uniform_variant<glm::bvec2>(uniform_variant const& variant, GLint location, GLint)
{
    if (variant.get_max_size() == 1)
    {
        glm::bvec2 const* ptr = static_cast<glm::bvec2 const*>(variant.get_buffer());
        gl_exec(glUniform2i, location, static_cast<GLint>((*ptr)[0]), static_cast<GLint>((*ptr)[1]));
    }
    else
    {
        uniform_variant::pointer_info const ptr_info = variant.get_ptr_info();
        gl_exec(glUniform2iv, location, static_cast<GLsizei>(static_cast<GLsizei>(ptr_info.m_size)), glm::value_ptr(*static_cast<glm::ivec2 const*>(ptr_info.m_ptr)));
    }
}

