
template<>
void apply_uniform_variant<bool>(uniform_variant const& variant, GLint location, GLint)
{
    if (variant.get_max_size() == 1)
    {
        gl_exec(glUniform1i, location, *static_cast<bool const*>(variant.get_buffer()));
    }
    else
    {
        uniform_variant::pointer_info const ptr_info = variant.get_ptr_info();
        gl_exec(glUniform1iv, location, static_cast<GLsizei>(static_cast<GLsizei>(ptr_info.m_size)), static_cast<GLint const*>(ptr_info.m_ptr));
    }
}

