template<>
void apply_uniform_variant<gcore::resource_handle<texture>>(uniform_variant const& variant, GLint location, GLint texture_unit)
{
    if (variant.get_max_size() == 1)
    {
        auto* texture_info = static_cast<gcore::resource_handle<texture> const*>(variant.get_buffer());
        gl_exec(glActiveTexture, GL_TEXTURE0 + texture_unit);
        gl_exec(glBindTexture, uniform_variant::get_gl_texture_type(variant.get_type()), texture_info->is_loaded() ? (*texture_info)->get_id() : 0);
        gl_exec(glUniform1i, location, texture_unit);
    }
    else
    {
        uniform_variant::pointer_info const ptr_info = variant.get_ptr_info();
        for(int i = 0; i < ptr_info.m_size; ++i)
        {
            gl_exec(glActiveTexture, GL_TEXTURE0 + texture_unit + i);
            auto* texture_info = static_cast<gcore::resource_handle<texture> const*>(ptr_info.m_ptr) + i;
            gl_exec(glBindTexture, uniform_variant::get_gl_texture_type(variant.get_type()), texture_info->is_loaded() ? (*texture_info)->get_id() : 0);
            gl_exec(glUniform1i, location + i, texture_unit + i);
        }
    }
}

template<>
void construct_uniform_variant<void>(uniform_variant&) {}
template<>
void destroy_uniform_variant<void>(uniform_variant&) {}
template<>
void copy_array_uniform_variant<void>(uniform_variant&, void const*, std::size_t) {}
template<>
void move_uniform_variant<void>(uniform_variant&&, uniform_variant&) {}
template<>
void process_uniform_variant<void>(gserializer::serializer&, uniform_variant&) {}

